# Gercek fis analizi icin zorunludur.
GEMINI_API_KEY=
# Gorsel girdi ve structured output destekleyen bir model kullanin.
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL baglantisi. Bos birakilirsa tarayici localStorage kullanilir.
DATABASE_URL=postgresql://receiptflow:receiptflow@localhost:5432/receiptflow

# ReceiptFlow oturumunu imzalamak icin guclu ve rastgele bir deger.
AUTH_SECRET=
AUTH_URL=http://localhost:3001

# GateHub panelinde ReceiptFlow icin olusturulan OIDC istemci bilgileri.
GATEHUB_ISSUER=http://localhost:3000/api/auth
GATEHUB_CLIENT_ID=
GATEHUB_CLIENT_SECRET=


